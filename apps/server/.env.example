# Server Environment Variables (Project Bash)
# Copy this file to .env and fill in real values

NODE_ENV=development
PORT=4000

# MongoDB Connection String (defaults to local docker container)
MONGODB_URI=mongodb://localhost:27017/bash

# JWT Authentication (must be at least 32 characters)
JWT_SECRET=supersecretdevkeyatleast32charslong1234
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Third-Party AI Credentials (Strictly server-side only)
DEEPGRAM_API_KEY=mock_deepgram_api_key_for_dev_testing
GEMINI_API_KEY=mock_gemini_api_key_for_dev_testing
GROQ_API_KEY=mock_groq_api_key_for_dev_testing

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
